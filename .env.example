# Use the full Redis Cloud connection URL (recommended)
REDIS_URL=redis://default:your-password@your-host:your-port

# Or use separate values instead of REDIS_URL
# REDIS_HOST=your-host
# REDIS_PORT=your-port
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-password

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/food_order?retryWrites=true&w=majority
MONGO_DB_NAME=food_order

PORT=3000
